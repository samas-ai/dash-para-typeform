# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# URL do projeto (ex: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave "service_role". SEGREDO: nunca prefixe com NEXT_PUBLIC_, nunca commite.
# É ela que dá acesso de escrita/leitura ignorando o RLS, usada só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Typeform — Connect > Webhooks > (seu webhook) > Secret
# ---------------------------------------------------------------------------
# Qualquer string forte que você também cole no campo "Secret" do webhook.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TYPEFORM_WEBHOOK_SECRET=
